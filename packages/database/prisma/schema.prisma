generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  DELAYED      // Waiting for scheduled time
  PENDING      // Ready in the active queue
  PROCESSING   // Currently leased by a worker
  COMPLETED    // Terminal: Success
  FAILED       // Terminal: Failed after max retries
  DEAD_LETTER  // Terminal: Requires manual replay
}

model Job {
  id              String      @id @default(uuid())
  idempotencyKey  String      @unique
  name            String      
  payload         Json
  status          JobStatus   @default(PENDING)
  priority        Int         @default(0)
  
  // Timing & Visibility
  scheduledFor    DateTime    @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  lastHeartbeat   DateTime?
  expiresAt       DateTime?   // The "Lease" expiration
  
  // Resilience
  attempts        Int         @default(0)
  maxAttempts     Int         @default(3)
  errorLog        Json?       // Stack traces and failure reasons
  workerId        String?     // Identify which node has the lease

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  events          JobEvent[]

  @@index([status, scheduledFor])
  @@index([idempotencyKey])
  @@index([name])
  @@index([createdAt])
}

model JobEvent {
  id        String   @id @default(uuid())
  jobId     String
  type      String   // e.g., "CREATED", "CLAIMED", "COMPLETED", "FAILED", "DEAD_LETTER", "REPLAYED", "REQUEUED"
  message   String?
  timestamp DateTime @default(now())
  
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([timestamp])
}

model Worker {
  id            String   @id
  pool          String   @default("default")
  status        String   @default("ONLINE") // ONLINE, OFFLINE
  startedAt     DateTime @default(now())
  lastHeartbeat DateTime @default(now())
  cpu           Float    @default(0)
  memory        String   @default("0MB")
  currentJobId  String?

  @@index([status, lastHeartbeat])
}

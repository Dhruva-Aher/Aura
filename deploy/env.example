# Copy to repo root as .env.prod (never commit that file):
#   cp deploy/env.example .env.prod

# Public hostname for the API (A/AAAA DNS must point at your VPS).
# Used by Caddy for HTTPS (Let's Encrypt).
DOMAIN=api.yourdomain.com

# Use a long alphanumeric password (avoid @ : / ? # in the password —
# those break DATABASE_URL parsing in compose).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=aura

LOG_LEVEL=info

# Worker pool sizing
DEFAULT_WORKERS=2
HIGH_WORKERS=1
LOW_WORKERS=1
WORKER_CONCURRENCY=20
